# Public site URL (optional, used for social sharing)
NEXT_PUBLIC_SITE_URL=

# Google measurement (GA4 always required; GTM takes over loading when configured)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Instagram carousel planner (local or server-side only)
INSTAGRAM_BEDROCK_ACCESS_KEY_ID=
INSTAGRAM_BEDROCK_SECRET_ACCESS_KEY=
INSTAGRAM_BEDROCK_SESSION_TOKEN=
INSTAGRAM_BEDROCK_REGION=us-east-2
INSTAGRAM_BEDROCK_MODEL_ID=
INSTAGRAM_BEDROCK_PROFILE=

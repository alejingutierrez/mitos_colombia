# SQLite (local fallback)
MITOS_DB_PATH=./data/mitos.sqlite

# Postgres (production - Neon/Vercel)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public site URL (optional, used for social sharing)
NEXT_PUBLIC_SITE_URL=

# Google measurement (GA4 always required; GTM takes over loading when configured)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Tarot commerce. Keep preview until every commercial value is confirmed.
TAROT_COMMERCE_STATUS=preview
TAROT_PRICE_COP=124900
TAROT_TAXES_INCLUDED=true
TAROT_DISPATCH_TEXT=
# The checkout only opens when shipping is explicitly included in the price.
TAROT_SHIPPING_INCLUDED=true
TAROT_SHIPPING_TEXT=Envio incluido en el precio; cobertura exacta por confirmar
# Exact department labels separated by |, or ALL_COLOMBIA after national coverage is confirmed.
TAROT_SHIPPING_REGIONS=
TAROT_RETURNS_TEXT=
TAROT_PRODUCT_CONTENTS=
TAROT_PHYSICAL_SPECS=
# The current generated catalog art is explicitly approved for this stage, but remains provisional.
TAROT_PRODUCT_IMAGE=/commerce/tarot-product-provisional.png
TAROT_PRODUCT_IMAGE_STATUS=provisional
TAROT_PRODUCT_IMAGE_APPROVED_FOR_SALE=true
# Legal seller identity shown in checkout before payment.
TAROT_SELLER_LEGAL_NAME=
TAROT_SELLER_LEGAL_ID=
TAROT_SELLER_ADDRESS=
TAROT_SELLER_EMAIL=
TAROT_SELLER_PHONE=

# Bold - Boton de Pagos (Embedded Checkout). Its own key pair: the old
# BOLD_API_KEY_* / BOLD_SECRET_KEY_* belonged to "API Pagos en Linea", a
# different product whose endpoint answers 403 to every key. Do not reuse them.
# Get these four in bold.co > Integraciones > Llaves de integracion > Boton de pagos.
BOLD_ENVIRONMENT=test
# Identity key: public by design, it travels to the browser inside the button
# configuration and is also the credential for the payment-voucher lookup.
BOLD_BUTTON_IDENTITY_KEY_TEST=
# Secret key: signs the integrity hash and the webhook. Server-side only.
BOLD_BUTTON_SECRET_KEY_TEST=
BOLD_BUTTON_IDENTITY_KEY_PRODUCTION=
BOLD_BUTTON_SECRET_KEY_PRODUCTION=
# Methods promised on the site. Bold decides which ones the modal shows; this
# list only guards the public promise. Exact IDs confirmed in the Bold account.
TAROT_BOLD_PAYMENT_METHODS=card,pse,nequi,bancolombia,qr

# Enable only after the orders table and the signed webhook have been tested.
TAROT_ORDERS_READY=false
TAROT_BOLD_WEBHOOK_READY=false
# GA4 Measurement Protocol secret is server-side. Enable only after a verified
# test purchase appears once in GA4 and in the Google Ads conversion action.
# The current Vercel project already uses this server-side name.
GA_MEASUREMENT_API_SECRET=
# Optional equivalent alias accepted by the Tarot integration.
GA4_MEASUREMENT_PROTOCOL_API_SECRET=
TAROT_SERVER_PURCHASE_TRACKING_READY=false

# Instagram carousel planner (local or server-side only)
INSTAGRAM_BEDROCK_ACCESS_KEY_ID=
INSTAGRAM_BEDROCK_SECRET_ACCESS_KEY=
INSTAGRAM_BEDROCK_SESSION_TOKEN=
INSTAGRAM_BEDROCK_REGION=us-east-2
INSTAGRAM_BEDROCK_MODEL_ID=
INSTAGRAM_BEDROCK_PROFILE=

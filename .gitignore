node_modules
.next
.superpowers
.worktrees/

# Claude Code: settings.local.json guarda los permisos de esta maquina y ha
# llegado a contener tokens dentro de las reglas de allow, asi que nunca se
# versiona. launch.json si se versiona: solo declara el puerto de dev y es
# configuracion compartida del proyecto.
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/

artifacts/
.env
.env.*
!.env.example
.env.local
.DS_Store
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal
/data/*.db
mitos.db
myths.db
.env*.local

.vercel/*
!.vercel/project.json

# Artefactos de ejecución de Playwright: logs de consola y capturas de prueba.
# Las capturas de referencia de las plantillas viven en public/design-system/.
.playwright-cli/
output/playwright/

# Volcados crudos de la investigación de keywords: los regeneran los scripts
# de scripts/ads/. Sí se versionan los análisis (.md) y los payloads de
# Google Ads (.txt), que son el entregable.
docs/keyword-research/*.json
docs/keyword-research/*.csv

# Salida del pipeline de carruseles de Instagram, no fuente.
public/instagram/

# Edición v1 de la iconografía: la sustituyó v2, que es la que sirve la app.
# Regenerable con scripts/instagram/generate-iconography.mjs.
public/motifs/carousel/v1/

# Payloads regenerables de las tandas de Higgsfield (se reemiten con mitos:tanda)
scripts/tmp/

# Listas temporales del montador de stop-motion (las regenera montar.mjs)
content/videos/**/.concat-*.txt

# Salidas derivadas del laboratorio de stop-motion: los fotogramas estabilizados
# se rehacen gratis desde los generados (`estabilizar.mjs`), así que se versiona
# el plató y la zona de acción —que explican el resultado— pero no las 33 copias.
content/videos/muiscas/lab-stopmotion/*/*-estab/f*.jpg
content/videos/muiscas/lab-stopmotion/*/tmp-est/
content/videos/muiscas/lab-stopmotion/*/compuesto*/f*.jpg
content/videos/muiscas/lab-stopmotion/*/hoja-alineada/
# Los recortes con alfa del laboratorio de stop-motion pesan 4 MB cada uno (PNG
# RGBA a 1088x1920) y se rehacen por $0,48: se versiona lo compuesto, que es lo
# que explica el resultado, no el material crudo.
content/videos/muiscas/lab-stopmotion/*/recortes-*/
content/videos/muiscas/lab-stopmotion/*/hoja-recorte/

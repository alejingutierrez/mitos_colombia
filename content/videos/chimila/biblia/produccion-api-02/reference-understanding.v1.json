  "observations": [
    {
      "unit_id": "P07/H01",
      "source": "V11.txt, pp112–114 y123; PDF p73 y75 con pies de foto",
      "observation": "Algodón; falda corta hasta rodillas fijada con cordón; tela superior rectangular sin coser a los lados. Franjas rectas rojas, azules o marrones documentadas.",
      "decision": "Retirar blusas cruzadas, prendas largas y cinturones; usar rectángulos y cordones. No universalizar la banda de iniciados.",
      "uncertainty": "Registro de 1946, no prueba prehispánica ni traje/edad de la Cacica. P75 dice Mujer shamán: no confundir con Cacica ni inferir sexo por apariencia."
    },
    {
      "unit_id": "U07",
      "source": "V02-IMG02/03/06; V10-IMG05; V06.txt p33; V11.txt pp114–117",
      "observation": "Mochilas de algodón contemporáneas: cuerpo cilíndrico, base redonda, tejido fino, correa ancha y cordones. Las redes de carga de majagua del archivo no son evidencia de fique.",
      "decision": "Eliminar cuello plisado, parches y apariencia de cuero; traducir tejido con tiras planas finas de papel. Fique más grueso pero cerrado para semillas.",
      "uncertainty": "Forma y cierre del fique siguen provisionales; algodón contemporáneo no equivale a artefacto exacto del mito355."
    },
    {
      "unit_id": "A09",
      "source": "V06.pdf pp134–135, ilustraciones85–86",
      "observation": "Caparazones oscuros con centros ocres, cabeza pequeña, patas terrestres cortas; no armadura gigante enteramente marrón.",
      "decision": "Proporciones más naturales, placas planas oscuras y centros ocres. Corteza como metáfora material, no tejas de madera.",
      "uncertainty": "Chelonoidis denticulata es identificación del documento, no certificación taxonómica del mito366."
    },
    {
      "unit_id": "L01",
      "source": "V06-P107/048/049/059/108; V04-IMG05; V11.txt pp98–99",
      "observation": "Rastrojo, pastos, arbustos y árboles de altura/densidad desigual; sendero estrecho también en sector cerrado. Naara Kajmanta y Guatapurí no deben mezclarse como un único lugar.",
      "decision": "Monte y borde de regeneración asimétricos, hojas ovales/lanceoladas, camino angosto, roca pequeña y horizonte bajo. Suelo de papel plano.",
      "uncertainty": "Adaptación espacial ficticia; paisajes rurales actuales modificados no reconstruyen el monte histórico."
    },
    {
      "unit_id": "V01",
      "source": "Mito350 y L01 v2 revisado",
      "observation": "Estado de inundación vinculado a un maestro, no paisaje nuevo ni cosmología579.",
      "decision": "Editar sólo L01 v2, mantener tres encuadres y anclas, sumergir sendero y claro con planos de agua de papel.",
      "uncertainty": "Cubre sólo L01; las otras bases previstas todavía no existen."
    }
  ],

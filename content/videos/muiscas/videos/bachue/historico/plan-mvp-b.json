      "clip": "clips/c17.mp4",
      "xfade": true,
      "voice": "voces-mvp-b/voz09.mp3",
      "subtitle": "Entraron al agua tomados de la mano. Dos serpientes cerraron el círculo, y la laguna guardó silencio.",
      "sfx": "../../audio/sfx/sfx-laguna.mp3",
      "sfx_vol": 0.45

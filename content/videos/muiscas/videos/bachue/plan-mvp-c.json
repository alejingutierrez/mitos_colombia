    {
      "n": 7,
      "type": "motion",
      "clip": "clips/c07.mp4",
      "xfade": true,
      "voice": "voces-mvp-c/voz04.mp3",
      "subtitle": "El tiempo pasa como pasa el humo. El niño ya es hombre, y el valle se llena de voces."
    },
    {
      "n": 8,
      "type": "motion",
      "clip": "clips/c08.mp4"
    },
    {
      "n": 9,

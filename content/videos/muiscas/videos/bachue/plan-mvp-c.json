      "clip": "clips/c09.mp4",
      "xfade": true,
      "voice": "voces-mvp-c/voz05.mp3",
      "subtitle": "Bachué camina y la tierra florece en pueblos. Sus pies descalzos saben dónde duerme el agua."
    },
    {
      "n": 10,
      "type": "motion",
      "clip": "clips/c10.mp4",
      "sfx": "../../audio/sfx/sfx-laguna.mp3",

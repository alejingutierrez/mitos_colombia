      "xfade": true,
      "voice": "voces-mvp-c/voz02.mp3",
      "subtitle": "El agua se abre en círculos lentos. Sale una mujer con un niño de la mano: Bachué, la madre.",
      "sfx": "../../audio/sfx/sfx-laguna.mp3",
      "sfx_vol": 0.4
    },
    {
      "n": 4,
      "type": "motion",
      "clip": "clips/c04.mp4",

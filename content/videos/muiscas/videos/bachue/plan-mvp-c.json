    },
    {
      "n": 11,
      "type": "motion",
      "clip": "clips/c11.mp4",
      "xfade": true,
      "voice": "voces-mvp-c/voz06.mp3",
      "subtitle": "Va dejando semillas y palabras: guarden la cosecha, escúchense despacio, compartan el agua como se comparte la vida."
    },
    {
      "n": 12,
      "type": "motion",
      "clip": "clips/c12.mp4",

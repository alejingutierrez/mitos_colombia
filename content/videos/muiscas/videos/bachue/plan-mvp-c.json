    {
      "n": 5,
      "type": "motion",
      "clip": "clips/c05.mp4",
      "xfade": true,
      "voice": "voces-mvp-c/voz03.mp3",
      "subtitle": "Abajo, en el valle, una casa aprende a ser casa. El fuego cuenta su primera historia bajo las estrellas."
    },
    {
      "n": 6,
      "type": "motion",
      "clip": "clips/c06.mp4",
      "sfx": "../../audio/sfx/sfx-fogon.mp3",
      "sfx_vol": 0.4

    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": "mitos-colombia-prod",
        "DBName": "mitos",
        "Engine": "postgres",
        "EngineVersion": "17.11",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MasterUsername": "mitos_admin",
        "ManageMasterUserPassword": true,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "DBSubnetGroupName": {
          "Ref": "DbSubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurityGroup"
          }
        ],
        "BackupRetentionPeriod": 35,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true,
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "mitos-colombia"
          },
          {
            "Key": "Environment",
            "Value": "prod"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "Owner",
            "Value": "alegut"
          },
          {
            "Key": "CostCenter",
            "Value": "mitos-colombia"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },

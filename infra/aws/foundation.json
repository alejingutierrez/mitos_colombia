                {
                  "Fn::Sub": "${ArchiveBucket.Arn}/*"
                },
                {
                  "Fn::GetAtt": [
                    "OperationsBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${OperationsBucket.Arn}/*"
                }
              ]
            },
            {
              "Sid": "ReadAmazonPackagesAndOwnRegionImageLayers",
              "Effect": "Allow",
              "Principal": "*",
              "Action": [
                "s3:GetObject"
              ],
              "Resource": [
                "arn:aws:s3:::al2023-repos-us-east-1-de612dc2/*",
                "arn:aws:s3:::prod-us-east-1-starport-layer-bucket/*"
              ]
            }
          ]
        }
      }

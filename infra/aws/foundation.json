            "Key": "Project",
            "Value": "mitos-colombia"
          },
          {
            "Key": "Environment",
            "Value": "prod"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "Owner",
            "Value": "alegut"
          },
          {
            "Key": "CostCenter",
            "Value": "mitos-colombia"
          },
          {
            "Key": "Name",
            "Value": "mitos-colombia-prod"

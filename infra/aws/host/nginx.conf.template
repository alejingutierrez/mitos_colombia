# TLS origin config. Render @ORIGIN_SECRET@ in a root-owned file (0600).
# Enable only after a trusted origin certificate and CF origin headers exist.
map_hash_bucket_size 128;
map $http_x_mitos_origin $mitos_origin_allowed {
    default 0;
    "@ORIGIN_SECRET@" 1;
}
map $http_cloudfront_viewer_address $mitos_viewer_ip {
    default "";
    ~^([0-9.]+):[0-9]+$ $1;
    ~^\[(.+)\]:[0-9]+$ $1;
}
map $http_x_mitos_stage $mitos_stage_robots {
    default "";
    "1" "noindex, nofollow, noarchive";
}
include /etc/nginx/mitos-upstream.conf;
include /etc/nginx/mitos-inbox-upstream.conf;
server {
    listen 127.0.0.1:3080;
    server_name localhost;
    location / {
        proxy_pass http://mitos_web;
        proxy_http_version 1.1;
        proxy_set_header Host www.mitosdecolombia.com;
        proxy_set_header X-Mitos-Stage "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
server {
    listen 443 ssl;
    server_name origin.mitosdecolombia.com;
    ssl_certificate /etc/letsencrypt/live/origin.mitosdecolombia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/origin.mitosdecolombia.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($mitos_origin_allowed = 0) { return 403; }
    if ($mitos_viewer_ip = "") { return 403; }
    add_header X-Robots-Tag $mitos_stage_robots always;
    client_max_body_size 10m;
    # Durable callback stays up while web candidates and RDS writers are stopped.
    location = /api/tarot/bold/events {
        limit_except POST { deny all; }
        client_max_body_size 200k;
        proxy_pass http://mitos_inbox;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 20s;
    }
    # Keep immutable chunks in already-open pages independent of the retired host.
    location ^~ /_next/static/ {
        limit_except GET { deny all; }
        resolver 169.254.169.253 valid=300s ipv6=off;
        set $mitos_legacy_static https://media.mitosdecolombia.com/legacy-static/5eda812b19f82d706130a21fca4c4698c6ce58c5;
        proxy_pass $mitos_legacy_static$request_uri;
        proxy_set_header Host media.mitosdecolombia.com;
        proxy_ssl_server_name on;
        proxy_ssl_name media.mitosdecolombia.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
        proxy_read_timeout 30s;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ^~ /api/internal/ { return 404; }
    location / {
        proxy_pass http://mitos_web;
        proxy_http_version 1.1;
        proxy_set_header Host www.mitosdecolombia.com;
        proxy_set_header X-Forwarded-Host www.mitosdecolombia.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Mitos-Stage $http_x_mitos_stage;
        proxy_set_header X-Forwarded-For $mitos_viewer_ip;
        proxy_set_header X-Mitos-Client-IP $mitos_viewer_ip;
        proxy_set_header X-Mitos-Worker-Token "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}

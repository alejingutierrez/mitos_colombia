{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Mitos owned origin DNS and scoped DNS-01 renewal permissions",
  "Resources": {
    "OriginDNS": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": "Z10003897KR85ZBPM93O",
        "Name": "origin.mitosdecolombia.com",
        "Type": "A",
        "TTL": 60,
        "ResourceRecords": [
          "3.215.243.33"
        ]
      }
    },
    "OriginDNSRenewal": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "mitos-origin-dns-challenge",
        "Roles": [
          "mitos-colombia-prod-instance"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "route53:ChangeResourceRecordSets"
              ],
              "Resource": "arn:aws:route53:::hostedzone/Z10003897KR85ZBPM93O",
              "Condition": {
                "ForAllValues:StringEquals": {
                  "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
                    "_acme-challenge.origin.mitosdecolombia.com"
                  ],
                  "route53:ChangeResourceRecordSetsRecordTypes": [
                    "TXT"
                  ],
                  "route53:ChangeResourceRecordSetsActions": [
                    "UPSERT",
                    "DELETE"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "route53:GetChange"
              ],
              "Resource": "arn:aws:route53:::change/*"
            }
          ]
        }
      }
    }
  }
}

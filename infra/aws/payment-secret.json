{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Own Bold inbox secret only, retained/protected; keys and flags start empty and closed",
  "Resources": {
    "BoldSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "mitos-colombia/prod/bold-inbox",
        "Description": "Only Bold inbox keys/flags; initially closed, never inferred from public checkout.",
        "SecretString": "{\"environment\": \"production\", \"identityKey\": \"\", \"secretKey\": \"\", \"ordersReady\": false, \"webhookReady\": false}",
        "Tags": [
          {
            "Key": "Project",
            "Value": "mitos-colombia"
          },
          {
            "Key": "Environment",
            "Value": "prod"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "Owner",
            "Value": "alegut"
          },
          {
            "Key": "CostCenter",
            "Value": "mitos-colombia"
          }
        ]
      }
    }
  }
}
